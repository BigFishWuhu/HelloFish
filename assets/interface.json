{
    "interface_version": 2,
    "name": "HelloFish",
    "description": "基于 MaaFramework 的语音厅贡献榜信息采集工具。",
    "contact": "https://github.com/BigFishWuhu/HelloFish/issues",
    "license": "MIT",
    "welcome": "欢迎使用 HelloFish。启动任务前，请先将模拟器停留在厅列表页。",
    "github": "https://github.com/BigFishWuhu/HelloFish",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "语音厅贡献榜扫描",
            "entry": "VoiceHallScanStart"
        }
    ]
}
