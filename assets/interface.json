{
    "interface_version": 2,
    "name": "HelloFish",
    "description": "基于 MaaFramework 的语音厅贡献榜信息采集工具。",
    "contact": "https://github.com/BigFishWuhu/HelloFish/issues",
    "license": "MIT",
    "welcome": "欢迎使用 HelloFish。启动任务前，请先将模拟器停留在厅列表页。",
    "github": "https://github.com/BigFishWuhu/HelloFish",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "语音厅贡献榜扫描",
            "entry": "VoiceHallScanStart",
            "default_check": true,
            "description": "采集完成后可随时[查看贡献记录](http://127.0.0.1:8765/)，无需运行额外任务。",
            "option": [
                "ContributionRankLimit"
            ]
        }
    ],
    "option": {
        "ContributionRankLimit": {
            "type": "input",
            "label": "贡献榜扫描人数",
            "description": "设置每个厅只扫描贡献榜前多少名用户。",
            "inputs": [
                {
                    "name": "limit",
                    "label": "前 N 名",
                    "default": "30",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$",
                    "pattern_msg": "请输入 1 到 999 的整数。"
                }
            ],
            "pipeline_override": {
                "VoiceHallScanStart": {
                    "custom_action_param": {
                        "max_users_per_hall": "{limit}"
                    }
                }
            }
        }
    }
}
