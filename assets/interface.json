{
    "interface_version": 2,
    "name": "HelloFish",
    "description": "基于 MaaFramework 的语音厅贡献榜信息采集工具。",
    "contact": "https://github.com/BigFishWuhu/HelloFish/issues",
    "license": "MIT",
    "welcome": "欢迎使用 HelloFish。启动任务前，请先将模拟器停留在厅列表页。",
    "github": "https://github.com/BigFishWuhu/HelloFish",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "startup": {
        "exec": "python",
        "args": [
            "-u",
            "agent/contribution_viewer.py",
            "--serve"
        ],
        "cwd": ".",
        "name": "HelloFishContributionViewer"
    },
    "task": [
        {
            "name": "语音厅贡献榜扫描",
            "entry": "VoiceHallScanStart",
            "default_check": true,
            "description": "首次启动任务后，可在退出 MXU 前随时[查看贡献记录](http://127.0.0.1:8765/)；停止任务不会关闭页面。",
            "option": [
                "ContributionRankLimit",
                "SkipScannedToday",
                "CloudUpload"
            ]
        },
        {
            "name": "单厅贡献榜调试",
            "entry": "VoiceHallSingleDebugStart",
            "default_check": false,
            "description": "用于反复调试打不开贡献榜的厅。运行前请先手动进入目标厅并填写厅 ID；该任务不会读取或写入已扫描厅状态。",
            "option": [
                "SingleHallDebugConfig"
            ]
        }
    ],
    "option": {
        "ContributionRankLimit": {
            "type": "input",
            "label": "贡献榜扫描人数",
            "description": "设置每个厅只扫描贡献榜前多少名用户。",
            "inputs": [
                {
                    "name": "limit",
                    "label": "前 N 名",
                    "default": "100",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$",
                    "pattern_msg": "请输入 1 到 999 的整数。"
                }
            ],
            "pipeline_override": {
                "VoiceHallScanStart": {
                    "custom_action_param": {
                        "max_users_per_hall": "{limit}"
                    }
                }
            }
        },
        "SingleHallDebugConfig": {
            "type": "input",
            "label": "单厅调试配置",
            "description": "先手动进入目标厅，再填写厅 ID 和扫描人数。",
            "inputs": [
                {
                    "name": "hall_id",
                    "label": "厅 ID",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^\\d{4,8}$",
                    "pattern_msg": "请输入 4 到 8 位数字厅 ID。"
                },
                {
                    "name": "limit",
                    "label": "前 N 名",
                    "default": "100",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$",
                    "pattern_msg": "请输入 1 到 999 的整数。"
                }
            ],
            "pipeline_override": {
                "VoiceHallSingleDebugStart": {
                    "custom_action_param": {
                        "room_id": "{hall_id}",
                        "single_hall": true,
                        "max_users_per_hall": "{limit}"
                    }
                }
            }
        },
        "SkipScannedToday": {
            "type": "switch",
            "label": "跳过今天已扫描的厅",
            "description": "开启后仅跳过今天成功扫描过的厅；昨天及更早扫描过的厅仍会正常扫描。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "VoiceHallScanStart": {
                            "custom_action": "scan_voice_hall_contributions_skip_scanned"
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "VoiceHallScanStart": {
                            "custom_action": "scan_voice_hall_contributions"
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "CloudUpload": {
            "type": "input",
            "label": "云端上传",
            "description": "扫描成功后将记录上传到 HelloFish 云端服务；留空 URL 可关闭上传。",
            "inputs": [
                {
                    "name": "url",
                    "label": "服务地址",
                    "default": "",
                    "pipeline_type": "string"
                },
                {
                    "name": "username",
                    "label": "账号",
                    "default": "",
                    "pipeline_type": "string"
                },
                {
                    "name": "password",
                    "label": "密码",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "VoiceHallScanStart": {
                    "custom_action_param": {
                        "upload_cloud": true,
                        "cloud_url": "{url}",
                        "cloud_username": "{username}",
                        "cloud_password": "{password}"
                    }
                },
                "VoiceHallSingleDebugStart": {
                    "custom_action_param": {
                        "upload_cloud": true,
                        "cloud_url": "{url}",
                        "cloud_username": "{username}",
                        "cloud_password": "{password}"
                    }
                }
            }
        }
    }
}
